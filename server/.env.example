# برای اجرای توسعه (dev) این خط را خالی بگذارید یا حذف کنید.
# برای استقرار نهایی روی سیستم بدون اینترنت، حتماً NODE_ENV=production تنظیم شود
# تا سرور خروجی build شده فرانت (client/dist) را مستقیم serve کند.
NODE_ENV=development

PORT=5000
# در محیط بدون اینترنت، MongoDB باید به‌صورت لوکال روی همان سیستم نصب شده باشد؛
# آدرس زیر پیش‌فرض یک نصب لوکال است (برای Atlas این مقدار را در .env جایگزین کنید، فقط برای dev).
MONGODB_URI=mongodb://localhost:27017/online-survey
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin
